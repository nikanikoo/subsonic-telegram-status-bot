# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Channel username (such as @my_channel) or numeric ID (-100...)
TELEGRAM_CHANNEL_ID=
# Leave empty to create the status post automatically
TELEGRAM_MESSAGE_ID=

# Base URL of the server implementing the Subsonic API, without /rest
# (for example https://music.example.com)
SUBSONIC_URL=https://music.example.com
# Account used to authenticate to the Subsonic API
SUBSONIC_USERNAME=
SUBSONIC_PASSWORD=

# Polling frequency in seconds (minimum 5)
UPDATE_INTERVAL=5
# ru or en
LANGUAGE=en
